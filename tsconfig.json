{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "playwright*.config.ts"]
}
