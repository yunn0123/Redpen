{
  "name": "ui-feedback",
  "displayName": "redpen",
  "icon": "docs/images/redpen-logo.png",
  "description": "Annotate screenshots, sketch UI changes, and export clear instructions for your coding agent.",
  "version": "0.1.7",
  "publisher": "yunn030123",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunn0123/Redpen.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "uiFeedback.open",
        "title": "redpen: Open Canvas"
      }
    ],
    "customEditors": [
      {
        "viewType": "uiFeedback.editor",
        "displayName": "redpen",
        "selector": [
          {
            "filenamePattern": "*.uifeedback.json"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "uiFeedback.open",
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|webp)$/i",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/model.test.ts",
    "test:e2e": "playwright test",
    "dev": "node scripts/dev.mjs",
    "test:vscode": "playwright test --config playwright.native.config.ts",
    "package": "vsce package --no-dependencies --allow-missing-repository --out ui-feedback.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "konva": "^10.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
